# firstmate-self-update.service - systemd --user unit for the periodic
# self-update pass
#
# Tracked TEMPLATE, not a live unit. bin/fm-self-update-timer-arm.sh renders
# this template by substituting /tmp/fm-self-update-evidence.isbbnS/home with the resolved operational home
# and /home/martin_seibert/.no-mistakes/worktrees/e36b903ea8f4/01M2JJRH8TBA71M48QGCB8NWE8/bin/fm-self-update-timer.sh with the run wrapper, then installs the result at
# ~/.config/systemd/user/firstmate-self-update.service. Do not install or edit
# this file by hand; the arm helper owns the installed copy.
#
# Type=oneshot because the timer owns the cadence: unlike the capacity brake's
# long-running loop, this service does one pass and exits, so Restart=always
# does not apply. TimeoutStartSec is deliberately generous (minutes, not
# seconds) because the restart gate asks each mate to persist its open work
# before its agent is replaced. There is no [Install] section: the timer
# triggers this service by name, and enabling it would start a pass at login.
#
# PATH leads with the invoking user's harness install directories
# (%h/.local/bin, %h/.npm-global/bin): a gated restart of a local mate resolves
# that mate's harness executable from PATH, which the pin below would otherwise
# restrict to system directories.
#
# Operator-facing configuration, the six-hour cadence, and the gated-restart
# policy: docs/configuration.md "Self-update timer".
[Unit]
Description=Firstmate self-update pass (fast-forward the fleet and restart advanced mates)
After=default.target

[Service]
Type=oneshot
ExecStart=/home/martin_seibert/.no-mistakes/worktrees/e36b903ea8f4/01M2JJRH8TBA71M48QGCB8NWE8/bin/fm-self-update-timer.sh run
WorkingDirectory=/tmp/fm-self-update-evidence.isbbnS/home
Environment=HOME=%h
Environment=FM_HOME=/tmp/fm-self-update-evidence.isbbnS/home
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
TimeoutStartSec=30min

===== installed firstmate-self-update.timer (rendered) =====
# firstmate-self-update.timer - systemd --user timer for the periodic
# self-update pass
#
# Tracked TEMPLATE, not a live unit. bin/fm-self-update-timer-arm.sh installs
# this template at ~/.config/systemd/user/firstmate-self-update.timer and
# enables and starts the timer. Do not install or edit this file by hand; the
# arm helper owns the installed copy.
#
# Every six hours with Persistent=true, so a run missed while the machine was
# off or suspended is caught up at the next opportunity instead of silently
# skipped. One timer per firstmate home; a separate firstmate (proxmox) arms
# the same tracked code in its own home with its own timer.
#
# Operator-facing configuration and the gated-restart policy:
# docs/configuration.md "Self-update timer".
[Unit]
Description=Firstmate self-update timer (every 6 hours)

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00
Persistent=true
Unit=firstmate-self-update.service

[Install]
WantedBy=timers.target

